{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/tensorrt-edgellm/completion-projection-p0-event.schema.json",
  "title": "Frozen P0 unified phase event contract",
  "description": "Immutable pre-P1 telemetry anchor. Later schemas may add optional observability fields without changing this baseline contract.",
  "type": "object",
  "required": [
    "schema_version",
    "event_kind",
    "event_id",
    "run_id",
    "host_monotonic_ns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_kind": {
      "enum": [
        "decision",
        "dispatch",
        "completion"
      ]
    },
    "event_id": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "host_monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "decision_id": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_id": {
      "type": "integer",
      "minimum": 1
    },
    "plan_id": {
      "type": "integer",
      "minimum": 1
    },
    "execution_id": {
      "type": "integer",
      "minimum": 1
    },
    "action_id": {
      "type": "integer",
      "minimum": 1
    },
    "incremental_action_id": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "encoder",
        "prefill",
        "decode",
        "copy"
      ]
    },
    "action_direction": {
      "enum": [
        "idle_launch",
        "encoder_to_prefill",
        "prefill_to_encoder",
        "encoder_to_decode",
        "decode_to_encoder",
        "prefill_to_decode",
        "decode_to_prefill",
        "none"
      ]
    },
    "requested_start_skew_percent": {
      "enum": [-1, 0, 25, 50, 75, 90, 100]
    },
    "outstanding_before_mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "planned_outstanding_mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "observed_outstanding_mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "action_fidelity": {
      "type": "boolean"
    },
    "gpu_start_us": {
      "type": "number",
      "minimum": 0
    },
    "gpu_end_us": {
      "type": "number",
      "minimum": 0
    },
    "gpu_duration_us": {
      "type": "number",
      "minimum": 0
    }
  }
}
