{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/tensorrt-edgellm/directional-injection-artifact-v1.schema.json",
  "title": "TensorRT Edge-LLM M2 directional injection artifact",
  "type": "object",
  "required": [
    "schema_version",
    "target_buckets",
    "samples",
    "accepted_samples",
    "cells",
    "gate_a",
    "sources",
    "validation_errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target_buckets": {
      "const": [
        0.0,
        0.25,
        0.5,
        0.75,
        0.9
      ]
    },
    "samples": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_samples": {
      "type": "integer",
      "minimum": 0
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "gate_a": {
      "type": "object",
      "required": [
        "material_effect_ratio",
        "directions",
        "passed_directions"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": [
        "direction",
        "actual_bucket",
        "samples",
        "actual_fraction",
        "incumbent_duration_us",
        "newcomer_duration_us",
        "makespan_us"
      ]
    }
  },
  "additionalProperties": true
}
