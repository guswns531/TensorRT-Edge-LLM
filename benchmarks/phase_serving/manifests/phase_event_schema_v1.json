{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.com/tensorrt-edgellm/phase-event-v1.schema.json",
  "title": "TensorRT Edge-LLM unified phase event",
  "description": "M1 contract for decision, dispatch, and completion correlation. Host timestamps use CLOCK_MONOTONIC; GPU start and end timestamps share the phase activity recorder's CUDA-event epoch.",
  "type": "object",
  "required": [
    "schema_version",
    "event_kind",
    "event_id",
    "run_id",
    "host_monotonic_ns"
  ],
  "properties": {
    "selector_audit": {
      "$ref": "#/$defs/selectorAudit"
    },
    "pd_selector_audit": {
      "$ref": "#/$defs/selectorAudit"
    },
    "schema_version": {
      "const": 1
    },
    "event_kind": {
      "enum": [
        "decision",
        "dispatch",
        "completion"
      ]
    },
    "event_id": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "host_monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "decision_id": {
      "type": "integer",
      "minimum": 1
    },
    "policy_decision_sequence": {
      "description": "Enclosing E/P/D policy counter; zero before the first enclosing selection, including P/D-only dispatches.",
      "type": "integer",
      "minimum": 0
    },
    "snapshot_id": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_signature": {
      "description": "Cross-run FNV-1a identity of canonical ready lineage, in-flight phase state, and persistent ownership counts. Transient timestamps and process-local execution IDs are excluded.",
      "type": "integer",
      "minimum": 1
    },
    "strict_snapshot_signature": {
      "description": "Cross-run identity of the snapshot, full candidate frontier, exact row order, and persistent KV/vision ownership. The selected action and timestamps are excluded.",
      "type": "integer",
      "minimum": 1
    },
    "dispatch_signature": {
      "description": "Exact selected mechanism dispatch identity over the strict snapshot, ordered request/stable-slot candidate, launch direction, and outstanding-set transition.",
      "type": "integer",
      "minimum": 1
    },
    "kv_ownership_signature": {
      "description": "Cross-run identity of request-to-slot/page leases, generation, and committed KV length. Zero means the lightweight mode did not collect this hash.",
      "type": "integer",
      "minimum": 0
    },
    "scalar_policy_state_signature": {
      "description": "Cross-run identity of scalar cost and deadline inputs over the exact candidate frontier.",
      "type": "integer",
      "minimum": 1
    },
    "vision_lease_signature": {
      "description": "Cross-run identity of active and pending vision payload lifetimes. Zero means the lightweight mode did not collect this hash.",
      "type": "integer",
      "minimum": 0
    },
    "scalar_formation": {
      "$ref": "#/$defs/model_formation"
    },
    "plan_id": {
      "type": "integer",
      "minimum": 1
    },
    "execution_id": {
      "type": "integer",
      "minimum": 1
    },
    "action_id": {
      "type": "integer",
      "minimum": 1
    },
    "incremental_action_id": {
      "type": "integer",
      "minimum": 1
    },
    "requested_action_direction": {
      "enum": [
        "idle_launch",
        "encoder_to_prefill",
        "prefill_to_encoder",
        "encoder_to_decode",
        "decode_to_encoder",
        "prefill_to_decode",
        "decode_to_prefill",
        "none"
      ]
    },
    "requested_start_skew_percent": {
      "enum": [
        -1,
        0,
        25,
        50,
        75,
        90,
        100
      ]
    },
    "phase": {
      "enum": [
        "encoder",
        "prefill",
        "decode",
        "copy"
      ]
    },
    "action_kind": {
      "enum": [
        "none",
        "encoder",
        "prefill",
        "decode",
        "encoder_prefill",
        "encoder_decode",
        "prefill_decode",
        "wait"
      ]
    },
    "action_direction": {
      "enum": [
        "idle_launch",
        "encoder_to_prefill",
        "prefill_to_encoder",
        "encoder_to_decode",
        "decode_to_encoder",
        "prefill_to_decode",
        "decode_to_prefill",
        "none"
      ]
    },
    "dispatch_mode": {
      "enum": [
        "none",
        "single",
        "co_launch",
        "residual_augmentation"
      ]
    },
    "outstanding_before_mask": {
      "$ref": "#/$defs/activityMask"
    },
    "planned_outstanding_mask": {
      "$ref": "#/$defs/activityMask"
    },
    "observed_outstanding_mask": {
      "$ref": "#/$defs/activityMask"
    },
    "ready": {
      "$ref": "#/$defs/work"
    },
    "encoder_service": {
      "$ref": "#/$defs/serviceState"
    },
    "prefill_service": {
      "$ref": "#/$defs/serviceState"
    },
    "decode_service": {
      "$ref": "#/$defs/serviceState"
    },
    "cohort": {
      "$ref": "#/$defs/work"
    },
    "request_ids": {
      "$ref": "#/$defs/requestIds"
    },
    "ready_encoder_request_ids": {
      "$ref": "#/$defs/requestIds"
    },
    "ready_prefill_request_ids": {
      "$ref": "#/$defs/requestIds"
    },
    "ready_prefill_token_counts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "ready_decode_request_ids": {
      "$ref": "#/$defs/requestIds"
    },
    "ready_decode_context_lengths": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "page_pool_allocated_bundles": {
      "type": "integer",
      "minimum": 0
    },
    "page_reservation_guaranteed_bundles": {
      "type": "integer",
      "minimum": 0
    },
    "vision_payload_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "inflight": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inflight"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "selected_action_id": {
      "type": "integer",
      "minimum": 1
    },
    "scalar_h1_selected_action_id": {
      "type": "integer",
      "minimum": 0
    },
    "non_contextual_selected_action_id": {
      "type": "integer",
      "minimum": 0
    },
    "enqueue_host_ns": {
      "type": "integer",
      "minimum": 0
    },
    "incumbent_phase": {
      "$ref": "#/$defs/executionPhase"
    },
    "incumbent_execution_id": {
      "type": "integer",
      "minimum": 1
    },
    "incumbent_dispatch_age_us": {
      "type": "number",
      "minimum": 0
    },
    "newcomer_phase": {
      "$ref": "#/$defs/executionPhase"
    },
    "newcomer_execution_id": {
      "type": "integer",
      "minimum": 1
    },
    "observed_start_skew_percent": {
      "enum": [
        -1,
        0,
        25,
        50,
        75,
        90,
        100
      ]
    },
    "gpu_start_us": {
      "type": "number",
      "minimum": 0
    },
    "gpu_end_us": {
      "type": "number",
      "minimum": 0
    },
    "gpu_duration_us": {
      "type": "number",
      "minimum": 0
    },
    "incumbent_gpu_completion_us": {
      "type": "number",
      "minimum": 0
    },
    "newcomer_gpu_completion_us": {
      "type": "number",
      "minimum": 0
    },
    "completion_visible_host_ns": {
      "type": "integer",
      "minimum": 0
    },
    "completion_status": {
      "enum": [
        "success",
        "failed",
        "cancelled"
      ]
    },
    "action_fidelity": {
      "type": "boolean"
    },
    "action_fidelity_reason": {
      "enum": [
        "none",
        "missing_decision",
        "action_id_mismatch",
        "outstanding_mismatch"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "required": [
          "decision_id",
          "snapshot_id",
          "ready",
          "inflight",
          "candidates",
          "request_ids",
          "selected_action_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "dispatch"
          }
        }
      },
      "then": {
        "required": [
          "decision_id",
          "execution_id",
          "plan_id",
          "action_id",
          "phase",
          "action_kind",
          "action_direction",
          "outstanding_before_mask",
          "planned_outstanding_mask",
          "cohort",
          "request_ids",
          "enqueue_host_ns"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "completion"
          }
        }
      },
      "then": {
        "required": [
          "execution_id",
          "plan_id",
          "action_id",
          "phase",
          "observed_outstanding_mask",
          "request_ids",
          "gpu_duration_us",
          "completion_visible_host_ns",
          "completion_status",
          "action_fidelity"
        ]
      }
    }
  ],
  "$defs": {
    "selectorAudit": {
      "type": ["object", "null"],
      "required": ["inputs", "selected_action_id", "reason", "selected_violation_us"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action_id", "action_kind", "hard_feasible", "max_slo_violation_us", "violation_mask", "frontier_eligible", "dominated"],
            "properties": {
              "action_id": {"type": "integer", "minimum": 0},
              "action_kind": {"type": "string"},
              "hard_feasible": {"type": "boolean"},
              "max_slo_violation_us": {"type": "number", "minimum": 0},
              "violation_mask": {"type": "integer", "minimum": 0},
              "frontier_eligible": {"type": "boolean"},
              "dominated": {"type": "boolean"}
            }
          }
        },
        "selected_action_id": {"type": ["integer", "null"], "minimum": 0},
        "reason": {
          "enum": ["no_candidate", "no_hard_feasible_candidate", "deadline_safe_efficiency", "bounded_exploration", "minimum_violation", "all_late_efficiency_recovery"]
        },
        "selected_violation_us": {"type": "number", "minimum": 0},
        "post_select_override": {"type": "boolean"}
      }
    },
    "executionPhase": {
      "enum": [
        "encoder",
        "prefill",
        "decode"
      ]
    },
    "activityMask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15,
      "description": "E=1, P=2, D=4, Copy=8"
    },
    "work": {
      "type": "object",
      "required": [
        "encoder_rows",
        "prefill_rows",
        "prefill_tokens",
        "decode_rows"
      ],
      "properties": {
        "encoder_rows": {
          "type": "integer",
          "minimum": 0
        },
        "prefill_rows": {
          "type": "integer",
          "minimum": 0
        },
        "prefill_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "decode_rows": {
          "type": "integer",
          "minimum": 0
        },
        "mean_decode_context": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "requestIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "serviceState": {
      "type": "object",
      "required": [
        "request_id",
        "ready_wait_us",
        "service_age_quanta",
        "reference_us",
        "reference_source",
        "service_epoch",
        "reference_valid",
        "has_explicit_slo",
        "absolute_slack_us"
      ],
      "properties": {
        "request_id": {"type": "integer", "minimum": 0},
        "ready_wait_us": {"type": "number", "minimum": 0},
        "service_age_quanta": {"type": "number", "minimum": 0},
        "reference_us": {"type": "number", "minimum": 0},
        "reference_source": {
          "enum": ["unknown", "runtime_exact", "runtime_interpolated", "runtime_covering", "static_profile", "cold_fallback", "derived_isolated"]
        },
        "service_epoch": {"type": "integer", "minimum": 0},
        "reference_valid": {"type": "boolean"},
        "has_explicit_slo": {"type": "boolean"},
        "absolute_slack_us": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "protectedCompletion": {
      "type": "object",
      "required": [
        "kind",
        "slack_us",
        "predicted_completion_us",
        "uncertainty_us"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unknown",
            "encoder",
            "prefill",
            "decode"
          ]
        },
        "slack_us": {
          "type": "number"
        },
        "predicted_completion_us": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty_us": {
          "type": "number",
          "minimum": 0
        },
        "request_id": {
          "type": "integer",
          "minimum": 0
        },
        "reference_us": {
          "type": "number",
          "minimum": 0
        },
        "elapsed_service_us": {
          "type": "number",
          "minimum": 0
        },
        "reference_source": {
          "enum": [
            "unknown",
            "runtime_exact",
            "runtime_interpolated",
            "runtime_covering",
            "static_profile",
            "cold_fallback",
            "derived_isolated"
          ]
        },
        "has_explicit_slo": {
          "type": "boolean"
        },
        "absolute_slack_us": {
          "type": ["number", "null"]
        },
        "service_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "model_formation": {
      "type": "object",
      "required": [
        "evaluated",
        "valid",
        "selected_action_id",
        "selected_horizon_us",
        "selected_decode_violation_us",
        "selected_protected_violation_us"
      ],
      "properties": {
        "evaluated": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "selected_action_id": {
          "type": "integer",
          "minimum": 0
        },
        "selected_horizon_us": {
          "type": "number",
          "minimum": 0
        },
        "selected_decode_violation_us": {
          "type": "number",
          "minimum": 0
        },
        "selected_protected_violation_us": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "inflight": {
      "type": "object",
      "required": [
        "phase",
        "execution_id",
        "plan_id",
        "dispatch_age_us",
        "request_ids",
        "cohort"
      ],
      "properties": {
        "phase": {
          "$ref": "#/properties/phase"
        },
        "plan_id": {
          "type": "integer",
          "minimum": 1
        },
        "execution_id": {
          "type": "integer",
          "minimum": 1
        },
        "dispatch_age_us": {
          "type": "number",
          "minimum": 0
        },
        "cohort": {
          "$ref": "#/$defs/work"
        },
        "request_ids": {
          "$ref": "#/$defs/requestIds"
        },
        "completed_milestone": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": [
        "action_id",
        "action_kind",
        "request_ids",
        "legal"
      ],
      "properties": {
        "action_id": {
          "type": "integer",
          "minimum": 1
        },
        "action_kind": {
          "$ref": "#/properties/action_kind"
        },
        "residual_augmentation": {
          "type": "boolean"
        },
        "residual_anchor": {
          "enum": [
            "none",
            "prefill",
            "decode"
          ]
        },
        "legal": {
          "type": "boolean"
        },
        "request_ids": {
          "$ref": "#/$defs/requestIds"
        },
        "predicted_completion_us": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "uncertainty_us": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "max_slo_violation_us": {
          "description": "Null when the preview snapshot has not evaluated deadline safety; actual evaluations are in selector_audit.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "scalar_decision_cost_known": {
          "type": "boolean"
        },
        "contextual_scalar_authority_applied": {
          "type": "boolean"
        },
        "scalar_decision_makespan_us": {
          "type": "number",
          "minimum": 0
        },
        "scalar_protected_completions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protectedCompletion"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
