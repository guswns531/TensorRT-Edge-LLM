ARG BASE_IMAGE=tensorrt-edge-llm:qwen38-phase
FROM ${BASE_IMAGE}

ARG MAX_JOBS=12

COPY cpp/builder/llmBuilder.cpp cpp/builder/llmBuilder.cpp
COPY cpp/runtime/config/llmEngineConfig.cpp cpp/runtime/config/llmEngineConfig.cpp
COPY cpp/runtime/scheduling/independentPhaseCoordinator.cpp cpp/runtime/scheduling/independentPhaseCoordinator.cpp
COPY cpp/runtime/scheduling/independentPhaseCoordinator.h cpp/runtime/scheduling/independentPhaseCoordinator.h
COPY cpp/runtime/scheduling/independentPhaseAsyncServer.cpp cpp/runtime/scheduling/independentPhaseAsyncServer.cpp
COPY cpp/runtime/scheduling/independentPhaseAsyncServer.h cpp/runtime/scheduling/independentPhaseAsyncServer.h
COPY cpp/runtime/scheduling/phaseRecurrentStateActiveView.cpp cpp/runtime/scheduling/phaseRecurrentStateActiveView.cpp
COPY cpp/runtime/scheduling/phaseRecurrentStateActiveView.h cpp/runtime/scheduling/phaseRecurrentStateActiveView.h
COPY cpp/runtime/scheduling/phaseQueueScheduler.cpp cpp/runtime/scheduling/phaseQueueScheduler.cpp
COPY cpp/runtime/scheduling/phaseQueueScheduler.h cpp/runtime/scheduling/phaseQueueScheduler.h
COPY cpp/runtime/state/stableKVPageManager.cpp cpp/runtime/state/stableKVPageManager.cpp
COPY cpp/runtime/state/stableKVPageManager.h cpp/runtime/state/stableKVPageManager.h
COPY examples/llm/llm_phase_context_smoke.cpp examples/llm/llm_phase_context_smoke.cpp
COPY scripts/phase_openai_gateway.py scripts/phase_openai_gateway.py
COPY experiments/qwen38_thor/run_phase_server.sh experiments/qwen38_thor/run_phase_server.sh
COPY unittests/phaseRecurrentStateActiveViewTest.cpp unittests/phaseRecurrentStateActiveViewTest.cpp
COPY unittests/phaseQueueSchedulerTest.cpp unittests/phaseQueueSchedulerTest.cpp
COPY unittests/stableKVPageManagerTest.cpp unittests/stableKVPageManagerTest.cpp

RUN cmake -S . -B build -DBUILD_UNIT_TESTS=ON && \
    cmake --build build \
        --target llm_build llm_bench llm_inference unitTest \
        --parallel ${MAX_JOBS} && \
    if cmake --build build --target help | grep -q llm_phase_context_smoke; then \
        cmake --build build --target llm_phase_context_smoke --parallel ${MAX_JOBS}; \
    fi
